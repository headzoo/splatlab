{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://splatlab.local/schemas/cooper-physics-patch-v1.json",
  "title": "Splat Lab Cooper physics patch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "baseRevision",
    "prompt",
    "operations"
  ],
  "properties": {
    "baseRevision": {
      "type": "integer",
      "minimum": 1
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/operation"
      }
    }
  },
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "path",
        "value"
      ],
      "properties": {
        "op": {
          "const": "replace"
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "value": {}
      }
    }
  }
}
