# Supplied automatically when the Vercel project is connected to Neon.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Optional explicit override. Vercel's DATABASE_URL_UNPOOLED and
# POSTGRES_URL_NON_POOLING variables are also detected automatically.
DIRECT_URL=postgresql://user:password@host/database?sslmode=require
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
LAB_KEY_PEPPER=replace-with-a-different-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=https://your-preview-domain.vercel.app
