# Supplied automatically when the Vercel project is connected to Neon.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Optional explicit override. Vercel's DATABASE_URL_UNPOOLED and
# POSTGRES_URL_NON_POOLING variables are also detected automatically.
DIRECT_URL=postgresql://user:password@host/database?sslmode=require
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
LAB_KEY_PEPPER=replace-with-a-different-long-random-secret
LAB_KEY_CHECKSUM_SECRET=replace-with-another-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_TRUSTED_ORIGINS=https://your-preview-domain.vercel.app
# Blob storage. Connect the store to the Vercel project so Production gets
# BLOB_STORE_ID (and a read-write token). Pull locally with `vercel env pull`,
# or copy both values from the Blob store settings. Placeholders will not work.
BLOB_STORE_ID=store_replace-with-your-blob-store-id
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_replace-with-your-blob-token
# Server-only provider credentials for the Agentflow interpreter.
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-5-mini
