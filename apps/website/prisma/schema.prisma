generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String        @id
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamp(6)
  isAnonymous   Boolean?      @map("is_anonymous")
  sessions      Session[]
  accounts      Account[]
  labWorkspace  LabWorkspace?
  games         Game[]
  mediaAssets   MediaAsset[]
  agentFlowRuns AgentFlowRun[]

  @@map("user")
}

model Session {
  id            String   @id
  expiresAt     DateTime @map("expires_at") @db.Timestamp(6)
  token         String   @unique
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamp(6)
  ipAddress     String?  @map("ip_address")
  userAgent     String?  @map("user_agent")
  userId        String   @map("user_id")
  labKeyVersion Int      @default(0) @map("lab_key_version")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "session_userId_idx")
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamp(6)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamp(6)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamp(6)
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "account_userId_idx")
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at") @db.Timestamp(6)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamp(6)

  @@index([identifier], map: "verification_identifier_idx")
  @@map("verification")
}

model LabWorkspace {
  id         String   @id
  userId     String   @unique @map("user_id")
  keyLookup  String?  @unique @map("key_lookup")
  keyHash    String?  @map("key_hash")
  keyVersion Int      @default(0) @map("key_version")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamp(6)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("lab_workspace")
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limit")
}

model Game {
  id               String   @id @default(cuid())
  ownerId          String   @map("owner_id")
  title            String
  isPublic         Boolean  @default(false) @map("is_public")
  gameType         String   @map("game_type")
  mapSource        String   @map("map_source")
  spec             Json     @db.JsonB
  thumbnailDataUrl String?  @map("thumbnail_data_url") @db.Text
  revision         Int      @default(1)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamp(6)
  owner            User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  agentFlowRuns AgentFlowRun[]
  mediaAssets      MediaAsset[]

  @@unique([id, ownerId], map: "game_id_owner_id_key")
  @@index([ownerId, updatedAt(sort: Desc)], map: "game_owner_id_updated_at_idx")
  @@map("game")
}

model MediaAsset {
  id          String    @id @default(cuid())
  ownerId     String    @map("owner_id")
  gameId      String?   @map("game_id")
  gameOwnerId String?   @map("game_owner_id")
  kind        String
  url         String
  pathname    String    @unique
  contentType String    @map("content_type")
  byteSize    Int       @map("byte_size")
  posterUrl      String?   @map("poster_url")
  posterPathname String?   @unique @map("poster_pathname")
  durationMs     Int?      @map("duration_ms")
  width          Int?      @map("width")
  height         Int?      @map("height")
  quotaSlot   Int?      @map("quota_slot")
  readyAt     DateTime? @default(now()) @map("ready_at") @db.Timestamp(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamp(6)
  owner       User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  game        Game?     @relation(fields: [gameId, gameOwnerId], references: [id, ownerId], onDelete: SetNull, map: "media_asset_game_owner_fkey")

  @@unique([ownerId, kind, quotaSlot], map: "media_asset_owner_kind_quota_slot_key")
  @@index([ownerId, createdAt(sort: Desc)], map: "media_asset_owner_id_created_at_idx")
  @@map("media_asset")
}

enum AgentFlowRunStatus {
  running
  paused
  done
  failed
}

model AgentFlowRun {
  id                String             @id @default(cuid())
  ownerId           String             @map("owner_id")
  gameId            String             @map("game_id")
  flowId            String             @map("flow_id")
  flowHash          String             @map("flow_hash")
  status            AgentFlowRunStatus
  currentNodeId     String             @map("current_node_id")
  question          String
  flowState         Json               @map("flow_state") @db.JsonB
  flowOutput        Json               @map("flow_output") @db.JsonB
  loopCounts        Json               @map("loop_counts") @db.JsonB
  pendingHumanInput Json?              @map("pending_human_input") @db.JsonB
  revision          Int                @default(1)
  activeKey         String?            @unique @map("active_key")
  leaseExpiresAt    DateTime?          @map("lease_expires_at") @db.Timestamp(6)
  startedAt         DateTime           @default(now()) @map("started_at") @db.Timestamp(6)
  completedAt       DateTime?          @map("completed_at") @db.Timestamp(6)
  failureCode       String?            @map("failure_code")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamp(6)
  owner             User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  game              Game               @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@index([ownerId, gameId, updatedAt(sort: Desc)], map: "agent_flow_run_owner_game_updated_at_idx")
  @@index([status, updatedAt(sort: Desc)], map: "agent_flow_run_status_updated_at_idx")
  @@map("agent_flow_run")
}
